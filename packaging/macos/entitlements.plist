<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- USRP (UHD) and Airspy (libairspy) are loaded at run time from where the
       user installed them (Homebrew, MacPorts): libraries signed by other
       people, which the hardened runtime refuses without this. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
