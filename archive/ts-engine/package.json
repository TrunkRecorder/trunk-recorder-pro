{
  "name": "trunk-recorder-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trunk Recorder in the browser: an RTL-SDR over WebUSB records a P25 trunked system with nothing to install.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "replay": "node --experimental-strip-types --no-warnings tools/replay.ts"
  },
  "dependencies": {
    "@jtarrio/webrtlsdr": "3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-usb": "^1.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
